# Browser Use API Key
# Get your API key from https://cloud.browser-use.com/new-api-key
BROWSER_USE_API_KEY=your-api-key-here

# Agentmail API Key
# Get your API key from https://agentmail.to
AGENTMAIL_API_KEY=your-agentmail-api-key-here

# TikTok MS Token (REQUIRED for TikTok-Api scraper)
# Get from your browser cookies - TikTok will block requests without this!
# 1. Go to tiktok.com and do a search
# 2. Open DevTools (F12) -> Application -> Cookies
# 3. Copy the 'msToken' cookie value
TIKTOK_MS_TOKEN=your-ms-token-here

# Supabase Configuration (Optional - for automatic database insertion)
# If provided, scraped profiles will be automatically inserted into the contact table
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-key
